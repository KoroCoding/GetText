<Window x:Class="GetText.TextWindow"
        Icon="/Assets/app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GetText"
        Title="GetText"
        MinWidth="360" MinHeight="260"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource Gt.Font.Body}">
    <Window.Resources>
        <!-- 欄の右クリックメニュー -->
        <ContextMenu x:Key="PaneMenu" Opened="PaneMenu_Opened">
            <MenuItem Header="コピー" Command="ApplicationCommands.Copy" InputGestureText="Ctrl+C"/>
            <MenuItem Header="すべて選択" Command="ApplicationCommands.SelectAll" InputGestureText="Ctrl+A"/>
            <Separator/>
            <MenuItem Header="全文をコピー" Click="MenuCopyAll_Click"/>
            <MenuItem Header="ファイルに保存…" Click="MenuSave_Click"/>
            <Separator/>
            <MenuItem x:Name="ConvertMenu" Header="文字変換"/>
        </ContextMenu>

        <!-- 「表示」のメニュー: 並べ方・訳の位置・蓄積 -->
        <ContextMenu x:Key="ViewMenu" Opened="ViewMenu_Opened" Closed="Menu_Closed">
            <MenuItem x:Name="ViewTextItem" Header="上から順" IsCheckable="True" Click="ViewText_Click"
                      ToolTip="画面どおり、上から順に並べます"/>
            <MenuItem x:Name="ViewGroupsItem" Header="枠・まとまりごと" IsCheckable="True" Click="ViewGroups_Click"
                      ToolTip="枠で囲まれた所・離れて並んだかたまりごとに分け、【1】【2】… の見出しを付けます (名簿・表など)。まとまりが無ければ上から順のまま"/>
            <Separator/>
            <MenuItem x:Name="LayoutBelowItem" Header="日本語訳を原文の下に" IsCheckable="True" Click="LayoutBelow_Click"/>
            <MenuItem x:Name="LayoutRightItem" Header="日本語訳を原文の右に" IsCheckable="True" Click="LayoutRight_Click"/>
            <Separator/>
            <MenuItem x:Name="AccumulateItem" Header="蓄積 (スクロールしながら集める)" IsCheckable="True" Click="AccumulateItem_Click"
                      ToolTip="スクロールしながら読んだ内容を、重複なしでつなげて集めます (長い文書の取り込み用)"/>
        </ContextMenu>

        <!-- 「その他」のメニュー: よく使わない操作 -->
        <ContextMenu x:Key="MoreMenu" Closed="Menu_Closed">
            <MenuItem Header="原文をファイルに保存…" Click="SaveOcr_Click">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" FontSize="14" Text="{local:Icon Save}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem x:Name="SaveTranslationItem" Header="日本語訳をファイルに保存…" Click="SaveTranslation_Click"/>
            <Separator/>
            <MenuItem Header="議事録を開く" Click="Minutes_Click">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" FontSize="14" Text="{local:Icon Meeting}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="コマンドの一覧…" InputGestureText="Ctrl+K" Click="Palette_Click">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" FontSize="14" Text="{local:Icon Command}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="設定…" InputGestureText="Ctrl+," Click="Settings_Click">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" FontSize="14" Text="{local:Icon Settings}"/></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.Resources>

    <Grid Margin="8,4,8,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 操作バー: 読み取り (一時停止・今すぐ) | 検索・表示 | 手前に固定・その他 -->
        <Grid x:Name="Toolbar" Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="PauseToggle" Style="{StaticResource CommandToggle}" Click="PauseToggle_Click"
                              ToolTip="自動読み取りを一時停止 / 再開 (Ctrl+P ・ どこからでも Ctrl+Alt+P)" AutomationProperties.Name="一時停止">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="PauseIcon" Style="{StaticResource Icon}" Text="{local:Icon Pause}"/>
                        <TextBlock x:Name="PauseLabel" Text="一時停止" Margin="8,0,0,0" VerticalAlignment="Center" Tag="Label"/>
                    </StackPanel>
                </ToggleButton>
                <Button x:Name="RefreshButton" Style="{StaticResource CommandPush}" Click="Refresh_Click"
                        ToolTip="枠の中を今すぐ読み取る (F5 ・ どこからでも Ctrl+Alt+R)" AutomationProperties.Name="今すぐ読み取る">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="{local:Icon Refresh}"/>
                        <TextBlock Text="今すぐ読む" Margin="8,0,0,0" VerticalAlignment="Center" Tag="Label"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,0">
                <Rectangle Width="1" Margin="4,8,6,8" Fill="{DynamicResource Gt.Divider}"/>
                <ToggleButton x:Name="SearchToggle" Style="{StaticResource CommandToggle}" Click="SearchToggle_Click"
                              ToolTip="読み取った文字を検索 (Ctrl+F)。見つかった所は枠の上にも印を付けます" AutomationProperties.Name="検索">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="{local:Icon Search}"/>
                        <TextBlock Text="検索" Margin="8,0,0,0" VerticalAlignment="Center" Tag="Label"/>
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="ViewButton" Style="{StaticResource CommandMenu}" Click="ViewButton_Click"
                              ToolTip="並べ方 (上から順 / 枠・まとまりごと)・訳の位置・蓄積" AutomationProperties.Name="表示">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ViewIcon" Style="{StaticResource Icon}" Text="{local:Icon Layout}"/>
                        <TextBlock Text="表示" Margin="8,0,0,0" VerticalAlignment="Center" Tag="Label"/>
                        <TextBlock Style="{StaticResource Icon}" Text="{local:Icon ChevronDown}" FontSize="10" Margin="8,0,0,0"/>
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <ToggleButton x:Name="PinToggle" Style="{StaticResource CommandToggle}" Click="PinToggle_Click"
                              ToolTip="常に手前に表示" AutomationProperties.Name="常に手前に表示">
                    <TextBlock Style="{StaticResource Icon}" Text="{local:Icon Pin}"/>
                </ToggleButton>
                <ToggleButton x:Name="MoreButton" Style="{StaticResource CommandMenu}" Click="MoreButton_Click"
                              ToolTip="その他 (保存・議事録・コマンドの一覧・設定)" AutomationProperties.Name="その他">
                    <TextBlock Style="{StaticResource Icon}" Text="{local:Icon More}"/>
                </ToggleButton>
            </StackPanel>
        </Grid>

        <!-- 知らせの帯 (両方出るときは縦に並べる。重ねると下の帯のボタンが押せない) -->
        <StackPanel Grid.Row="1">
            <!-- AI の機能 (高精度の読み取り・PC 内の翻訳・議事録) が入っていないときの案内 -->
            <Border x:Name="SetupHint" Style="{StaticResource InfoBar}" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{local:Icon Close}" FontSize="11" VerticalAlignment="Top"
                            Click="SetupHintClose_Click" ToolTip="今後は表示しない" AutomationProperties.Name="案内を閉じる"/>
                    <Button DockPanel.Dock="Right" Content="セットアップ" Padding="12,4" Margin="8,0,4,0" VerticalAlignment="Center"
                            Click="SetupHintOpen_Click"/>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{local:Icon Info}" Margin="0,2,12,0"
                               VerticalAlignment="Top" Foreground="{DynamicResource Gt.AccentText}"/>
                    <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource Gt.TextPrimary}"
                               Text="今は Windows の標準の機能で読み取っています。AI の機能を入れると、読み取りが正確になり、PC の中だけで翻訳・議事録の文字起こしができます。"/>
                </DockPanel>
            </Border>

            <!-- AI OCR を準備している間 (その間も Windows OCR で読み取る) -->
            <Border x:Name="LoadingBar" Style="{StaticResource InfoBar}" Visibility="Collapsed">
                <DockPanel>
                    <ProgressBar DockPanel.Dock="Right" IsIndeterminate="True" Width="64" Height="4" Margin="12,0,12,0" VerticalAlignment="Center"
                                 AutomationProperties.Name="準備中"/>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{local:Icon Model}" Margin="0,2,12,0"
                               VerticalAlignment="Top" Foreground="{DynamicResource Gt.AccentText}"/>
                    <StackPanel>
                        <TextBlock Text="AI OCR を準備しています…" FontWeight="SemiBold" Foreground="{DynamicResource Gt.TextPrimary}"/>
                        <TextBlock x:Name="LoadingDetail" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None"
                                   Text="認識モデルを読み込んでいます。その間は Windows OCR で読み取ります。"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- AI OCR を使えないので Windows OCR で読み取っている (止まらずに続ける) -->
            <Border x:Name="FallbackBar" Style="{StaticResource InfoBar}" Visibility="Collapsed"
                    Background="{DynamicResource Gt.WarningSubtle}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{local:Icon Close}" FontSize="11" VerticalAlignment="Top"
                            Click="FallbackClose_Click" ToolTip="閉じる" AutomationProperties.Name="知らせを閉じる"/>
                    <Button x:Name="FallbackDetails" DockPanel.Dock="Right" Content="詳細" Padding="12,4" Margin="8,0,4,0" VerticalAlignment="Center"
                            Click="FallbackDetails_Click"/>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{local:Icon Warning}" Margin="0,2,12,0"
                               VerticalAlignment="Top" Foreground="{DynamicResource Gt.Warning}"/>
                    <StackPanel>
                        <TextBlock Text="AI OCR を使えません" FontWeight="SemiBold" Foreground="{DynamicResource Gt.TextPrimary}"/>
                        <TextBlock Style="{StaticResource Caption}" Foreground="{DynamicResource Gt.TextPrimary}" TextWrapping="Wrap" TextTrimming="None"
                                   Text="代わりに Windows OCR で読み取っています (しばらくしてから AI OCR をもう一度試します)。"/>
                        <TextBlock x:Name="FallbackText" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- どのアプリでも効くキーが、ほかのアプリと重なって使えないときの案内 -->
            <Border x:Name="HotkeyHint" Style="{StaticResource InfoBar}" Visibility="Collapsed" Background="{DynamicResource Gt.WarningSubtle}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{local:Icon Close}" FontSize="11" VerticalAlignment="Top"
                            Click="HotkeyHintClose_Click" ToolTip="閉じる" AutomationProperties.Name="案内を閉じる"/>
                    <Button DockPanel.Dock="Right" Content="キーを変える" Padding="12,4" Margin="8,0,4,0" VerticalAlignment="Center"
                            Click="HotkeyHintOpen_Click"/>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{local:Icon Warning}" Margin="0,2,12,0"
                               VerticalAlignment="Top" Foreground="{DynamicResource Gt.Warning}"/>
                    <TextBlock x:Name="HotkeyHintText" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource Gt.TextPrimary}"/>
                </DockPanel>
            </Border>

            <!-- 蓄積中 -->
            <Border x:Name="AccumulateBar" Style="{StaticResource InfoBar}" Visibility="Collapsed" Padding="12,4,4,4">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource CommandPush}" Click="AccumulateEnd_Click" AutomationProperties.Name="蓄積を終える">
                        <TextBlock Text="終える"/>
                    </Button>
                    <Button x:Name="ClearButton" DockPanel.Dock="Right" Style="{StaticResource CommandPush}" Click="Clear_Click"
                            ToolTip="蓄積した内容を消して集め直す" AutomationProperties.Name="蓄積をクリア">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="{local:Icon Clear}" FontSize="14"/>
                            <TextBlock Text="クリア" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Style="{StaticResource Icon}" Text="{local:Icon Accumulate}" Margin="0,0,12,0" Foreground="{DynamicResource Gt.AccentText}"/>
                    <TextBlock x:Name="AccumulateText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Gt.TextPrimary}"
                               Text="蓄積中: スクロールすると、読んだ内容を重複なしで追記します"/>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- 原文と日本語訳 (配置は「表示」で下 / 右を切り替える) -->
        <Grid x:Name="PaneGrid" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border x:Name="OcrCard" Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="12,6,4,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{local:Icon Save}"
                                Click="SaveOcr_Click" ToolTip="ファイルに保存" AutomationProperties.Name="原文をファイルに保存"/>
                        <Button x:Name="CopyOcrButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{local:Icon Copy}"
                                Click="CopyOcr_Click" AutomationProperties.Name="原文をコピー"
                                ToolTip="コピー: 選択範囲があればその部分、なければ全文 (Ctrl+Shift+C ・ どこからでも Ctrl+Alt+C)"/>
                        <TextBlock Style="{StaticResource CardTitle}" Text="原文"/>
                        <TextBlock x:Name="OcrNote" Style="{StaticResource Caption}" Margin="12,0,8,0"/>
                    </DockPanel>
                    <!-- 検索 (Ctrl+F): 原文の欄の右上に浮かべる (欄の上に 1 行。読み取りが更新されても動かない) -->
                    <Border x:Name="SearchBar" DockPanel.Dock="Top" Margin="8,4,8,4" Visibility="Collapsed"
                            Background="{DynamicResource Gt.SurfaceSecondary}" BorderBrush="{DynamicResource Gt.Border}" BorderThickness="1"
                            CornerRadius="{StaticResource Gt.Radius.Card}" Padding="8,4,4,4">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{local:Icon Close}" FontSize="11"
                                    Click="SearchClose_Click" ToolTip="検索を閉じる (Esc)" AutomationProperties.Name="検索を閉じる"/>
                            <Button x:Name="SearchNextButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{local:Icon ArrowDown}" FontSize="12"
                                    Click="SearchNext_Click" ToolTip="次 (Enter ・ F3)" AutomationProperties.Name="次の一致"/>
                            <Button x:Name="SearchPrevButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{local:Icon ArrowUp}" FontSize="12"
                                    Click="SearchPrev_Click" ToolTip="前 (Shift+Enter ・ Shift+F3)" AutomationProperties.Name="前の一致"/>
                            <TextBlock x:Name="SearchCount" DockPanel.Dock="Right" Style="{StaticResource Caption}" MinWidth="44" TextAlignment="Right" Margin="4,0,4,0"
                                       AutomationProperties.LiveSetting="Polite"/>
                            <TextBlock Style="{StaticResource Icon}" Text="{local:Icon Search}" FontSize="14" Foreground="{DynamicResource Gt.TextSecondary}" Margin="0,0,8,0"/>
                            <Grid>
                                <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Gt.TextPrimary}"
                                         CaretBrush="{DynamicResource Gt.TextPrimary}" VerticalContentAlignment="Center" Padding="0,4"
                                         TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"
                                         AutomationProperties.Name="読み取った文字を検索">
                                    <TextBox.Template>
                                        <ControlTemplate TargetType="TextBox">
                                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                        </ControlTemplate>
                                    </TextBox.Template>
                                </TextBox>
                                <TextBlock x:Name="SearchPlaceholder" Text="原文を検索" IsHitTestVisible="False" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Gt.TextTertiary}"/>
                            </Grid>
                        </DockPanel>
                    </Border>
                    <Grid>
                        <TextBox x:Name="ResultBox" Style="{StaticResource ResultText}" AutomationProperties.Name="読み取った原文"
                                 ContextMenu="{StaticResource PaneMenu}"
                                 SelectionChanged="Box_SelectionChanged" PreviewMouseWheel="Box_PreviewMouseWheel"/>
                        <!-- 空の状態: 何をすればよいか -->
                        <DockPanel x:Name="OcrPlaceholder" Margin="14,8,14,0" VerticalAlignment="Top" IsHitTestVisible="False">
                            <Viewbox DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,12,0" VerticalAlignment="Top">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource BrandCorners}" Stroke="{DynamicResource Gt.TextTertiary}" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Path Data="{StaticResource BrandLines}" Stroke="{DynamicResource Gt.TextTertiary}" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                            <StackPanel>
                                <TextBlock x:Name="OcrEmptyTitle" Text="枠を読みたい文字の上に重ねてください" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Gt.TextPrimary}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="OcrEmptyDetail" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0"
                                           Text="枠の中の文字がここに表示されます。枠は上のバーで移動、縁や角でサイズを変えられます。"/>
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="Splitter" Background="Transparent" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" ToolTip="ドラッグで大きさを調整"/>

            <Border x:Name="TranslationCard" Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="12,6,4,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{local:Icon Save}"
                                Click="SaveTranslation_Click" ToolTip="ファイルに保存" AutomationProperties.Name="日本語訳をファイルに保存"/>
                        <Button x:Name="CopyTranslationButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{local:Icon Copy}"
                                Click="CopyTranslation_Click" AutomationProperties.Name="日本語訳をコピー"
                                ToolTip="コピー: 選択範囲があればその部分、なければ全文 (Ctrl+Shift+T ・ どこからでも Ctrl+Alt+T)"/>
                        <TextBlock Style="{StaticResource CardTitle}" Text="日本語訳"/>
                        <TextBlock x:Name="TranslationNote" Style="{StaticResource Caption}" Margin="12,0,8,0"/>
                    </DockPanel>
                    <Grid>
                        <TextBox x:Name="TranslationBox" Style="{StaticResource ResultText}" AutomationProperties.Name="日本語訳"
                                 ContextMenu="{StaticResource PaneMenu}"
                                 SelectionChanged="Box_SelectionChanged" PreviewMouseWheel="Box_PreviewMouseWheel"/>
                        <TextBlock x:Name="TranslationPlaceholder" Style="{StaticResource Caption}" Margin="14,8,14,0"
                                   VerticalAlignment="Top" TextWrapping="Wrap" TextTrimming="None" IsHitTestVisible="False"
                                   Text="英語・中国語・韓国語などの文があると、ここに日本語訳が表示されます。"/>
                    </Grid>
                </DockPanel>
            </Border>

        </Grid>

        <!-- ステータスバー: 状態 (左) と、読み取り・翻訳の方式 (右。詳しくはマウスを乗せると出る) -->
        <DockPanel Grid.Row="3" Margin="4,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <StackPanel x:Name="OcrChipPanel" Orientation="Horizontal" ToolTip="読み取りの方式" Margin="12,0,0,0">
                    <TextBlock x:Name="OcrChip" Style="{StaticResource Caption}"/>
                </StackPanel>
                <StackPanel x:Name="TranslationChipBorder" Orientation="Horizontal" Margin="12,0,0,0" ToolTip="翻訳の方式">
                    <TextBlock x:Name="TranslationPlaceIcon" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource Gt.TextSecondary}" Margin="0,0,4,0"/>
                    <TextBlock x:Name="TranslationChip" Style="{StaticResource Caption}"/>
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" AutomationProperties.LiveSetting="Polite"/>
        </DockPanel>
    </Grid>
</Window>
