<Window x:Class="GetText.SettingsWindow"
        Icon="/Assets/app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GetText の設定" Width="720" Height="600" MinWidth="660" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <Window.Resources>
        <Style x:Key="RowCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinWidth" Value="200"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
        </Style>
        <Style x:Key="RowCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>
        <Style x:Key="Page" TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Padding" Value="4,0,12,12"/>
        </Style>
    </Window.Resources>

    <!-- Windows 11 の設定アプリのように左に縦のメニューを並べる -->
    <TabControl x:Name="Tabs" Margin="4,8,8,8" TabStripPlacement="Left"
                Template="{StaticResource DefaultLeftTabControlStyle}">
        <!-- ───────── 読み取り ───────── -->
        <TabItem Header="読み取り">
            <ScrollViewer Style="{StaticResource Page}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingHeader}" Text="OCR エンジン"/>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <ComboBox x:Name="OcrEngineBox" DockPanel.Dock="Right" Style="{StaticResource RowCombo}"
                                      MinWidth="250" SelectionChanged="OcrEngineBox_SelectionChanged"/>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingLabel}" Text="文字の読み取り方式"/>
                                <TextBlock x:Name="OcrEngineDescription" Style="{StaticResource SettingDescription}"
                                           Text="AI は記号・表・小さな文字まで正確に読めます (要セットアップ)。使えないときは自動で Windows 標準に切り替わります。"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <ComboBox x:Name="IntervalBox" DockPanel.Dock="Right" Style="{StaticResource RowCombo}"
                                      MinWidth="120" SelectionChanged="IntervalBox_SelectionChanged"/>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingLabel}" Text="読み取りの間隔"/>
                                <TextBlock Style="{StaticResource SettingDescription}"
                                           Text="画面に変化がないときは読み取りを省きます。動画など変わり続ける画面では、短いほど CPU を多く使います。"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <CheckBox x:Name="JoinCheck" DockPanel.Dock="Right" Style="{StaticResource RowCheck}"
                                      Click="JoinCheck_Click"/>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingLabel}" Text="和文の文字間の空白を詰める"/>
                                <TextBlock Style="{StaticResource SettingDescription}"
                                           Text="「日 本 語」のように 1 文字ずつ空いてしまうのを「日本語」にします。"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Expander x:Name="WindowsOcrDetails" Header="Windows 標準 OCR の詳細 (言語・拡大・高精度モード)" Margin="0,14,0,0"
                              HorizontalAlignment="Stretch" IsExpanded="False">
                    <StackPanel Margin="0,6,0,0">
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <ComboBox x:Name="LanguageBox" DockPanel.Dock="Right" Style="{StaticResource RowCombo}"
                                      MinWidth="160" SelectionChanged="LanguageBox_SelectionChanged"/>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingLabel}" Text="言語"/>
                                <TextBlock Style="{StaticResource SettingDescription}"
                                           Text="英語の OCR も入れると「自動」が選べます (Windows の設定 → 時刻と言語 → 言語と地域 → 英語を追加)。"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <ComboBox x:Name="ScaleBox" DockPanel.Dock="Right" Style="{StaticResource RowCombo}"
                                      MinWidth="120" SelectionChanged="ScaleBox_SelectionChanged"/>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingLabel}" Text="拡大"/>
                                <TextBlock Style="{StaticResource SettingDescription}"
                                           Text="自動: 文字の大きさを測って最適な倍率で読み取ります。"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <CheckBox x:Name="AccuracyCheck" DockPanel.Dock="Right" Style="{StaticResource RowCheck}"
                                      Click="AccuracyCheck_Click"/>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingLabel}" Text="高精度モード"/>
                                <TextBlock Style="{StaticResource SettingDescription}"
                                           Text="暗い背景の反転・高品質拡大・複数倍率での多数決・文脈補正を行います。"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ───────── 翻訳 ───────── -->
        <TabItem Header="翻訳">
            <ScrollViewer Style="{StaticResource Page}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingHeader}" Text="日本語訳"/>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <CheckBox x:Name="TranslateCheck" DockPanel.Dock="Right" Style="{StaticResource RowCheck}"
                                      Click="TranslateCheck_Click"/>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingLabel}" Text="外国語の文を日本語に翻訳して表示する"/>
                                <TextBlock Style="{StaticResource SettingDescription}"
                                           Text="日本語の行はそのまま表示し、外国語と判定した文だけを翻訳します。"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <ComboBox x:Name="EngineBox" DockPanel.Dock="Right" Style="{StaticResource RowCombo}"
                                      MinWidth="250" SelectionChanged="EngineBox_SelectionChanged"/>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingLabel}" Text="翻訳エンジン"/>
                                <TextBlock x:Name="EngineDescription" Style="{StaticResource SettingDescription}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border x:Name="DeepLRow" Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="キーを設定…" Margin="12,0,0,0" VerticalAlignment="Center"
                                    Click="KeyButton_Click"/>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingLabel}" Text="DeepL API キー"/>
                                <TextBlock x:Name="KeyStatus" Style="{StaticResource SettingDescription}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ───────── 表示 ───────── -->
        <TabItem Header="表示">
            <ScrollViewer Style="{StaticResource Page}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingHeader}" Text="見た目"/>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <ComboBox x:Name="ThemeBox" DockPanel.Dock="Right" Style="{StaticResource RowCombo}"
                                      SelectionChanged="ThemeBox_SelectionChanged"/>
                            <TextBlock Style="{StaticResource SettingLabel}" Text="テーマ" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <ComboBox x:Name="LayoutBox" DockPanel.Dock="Right" Style="{StaticResource RowCombo}"
                                      MinWidth="140" SelectionChanged="LayoutBox_SelectionChanged"/>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingLabel}" Text="日本語訳の位置"/>
                                <TextBlock Style="{StaticResource SettingDescription}" Text="横長のウィンドウでは「右」が見やすくなります。"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Slider x:Name="FontSlider" Width="160" Minimum="9" Maximum="40" SmallChange="1" LargeChange="2"
                                        IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                                        ValueChanged="FontSlider_ValueChanged"/>
                                <TextBlock x:Name="FontValue" Width="40" TextAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingLabel}" Text="読み取った文字の大きさ"/>
                                <TextBlock Style="{StaticResource SettingDescription}" Text="原文・日本語訳の欄の文字です。欄の上で Ctrl+ホイールでも変えられます。"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <CheckBox x:Name="WrapCheck" DockPanel.Dock="Right" Style="{StaticResource RowCheck}" Click="WrapCheck_Click"/>
                            <TextBlock Style="{StaticResource SettingLabel}" Text="長い行を折り返す" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <ComboBox x:Name="ConvertBox" DockPanel.Dock="Right" Style="{StaticResource RowCombo}"
                                      MinWidth="160" SelectionChanged="ConvertBox_SelectionChanged"/>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingLabel}" Text="文字変換"/>
                                <TextBlock Style="{StaticResource SettingDescription}"
                                           Text="表示とコピーする文字を変換します。欄の右クリックメニューからも切り替えられます。"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SettingHeader}" Text="ウィンドウ"/>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <CheckBox x:Name="TopmostCheck" DockPanel.Dock="Right" Style="{StaticResource RowCheck}" Click="TopmostCheck_Click"/>
                            <TextBlock Style="{StaticResource SettingLabel}" Text="常に手前に表示する" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <CheckBox x:Name="FollowCheck" DockPanel.Dock="Right" Style="{StaticResource RowCheck}" Click="FollowCheck_Click"/>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingLabel}" Text="読み取り枠の右側について行く"/>
                                <TextBlock Style="{StaticResource SettingDescription}" Text="枠を動かすと、このウィンドウも枠の右隣に移動します。"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ───────── 議事録 ───────── -->
        <TabItem Header="議事録">
            <ScrollViewer Style="{StaticResource Page}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingHeader}" Text="議事録"/>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Slider x:Name="MinutesFontSlider" Width="160" Minimum="9" Maximum="40" SmallChange="1" LargeChange="2"
                                        IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                                        ValueChanged="MinutesFontSlider_ValueChanged"/>
                                <TextBlock x:Name="MinutesFontValue" Width="40" TextAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingLabel}" Text="議事録の文字の大きさ"/>
                                <TextBlock Style="{StaticResource SettingDescription}" Text="議事録の発言の文字です。議事録の画面で Ctrl+ホイール、または Ctrl キーと +・−・0 でも変えられます。"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <CheckBox x:Name="MinutesTimeCheck" DockPanel.Dock="Right" Style="{StaticResource RowCheck}" Click="MinutesDisplay_Click"/>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingLabel}" Text="発言の時刻を表示する"/>
                                <TextBlock Style="{StaticResource SettingDescription}" Text="発言の時刻 (ファイルでは先頭からの時間) を表示し、コピー・保存にも含めます。議事録の画面の「表示」でも変えられます。"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <CheckBox x:Name="MinutesTranslateCheck" DockPanel.Dock="Right" Style="{StaticResource RowCheck}" Click="MinutesDisplay_Click"/>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingLabel}" Text="日本語以外の発言に日本語訳を付ける"/>
                                <TextBlock Style="{StaticResource SettingDescription}" Text="英語などの発言の下に日本語訳を出し、コピー・保存にも含めます (PC の中で訳します)。"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <CheckBox x:Name="MinutesFillerCheck" DockPanel.Dock="Right" Style="{StaticResource RowCheck}" Click="MinutesDisplay_Click"/>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingLabel}" Text="相づちを除く"/>
                                <TextBlock Style="{StaticResource SettingDescription}" Text="「はい」「なるほど」「えーと」などだけの発言を、画面とコピー・保存から除きます (隠すだけなので、外すと戻ります)。"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <CheckBox x:Name="MinutesScrollCheck" DockPanel.Dock="Right" Style="{StaticResource RowCheck}" Click="MinutesDisplay_Click"/>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingLabel}" Text="自動スクロール"/>
                                <TextBlock Style="{StaticResource SettingDescription}" Text="新しい発言が加わるたびに、いちばん下 (最新) までスクロールします。発言を書き直している間は止まります。"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <CheckBox x:Name="MinutesAiTranslateCheck" DockPanel.Dock="Right" Style="{StaticResource RowCheck}"
                                      Click="MinutesAiTranslate_Click"/>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingLabel}" Text="日本語訳を AI で作る (前後の発言と用語を使う)"/>
                                <TextBlock Style="{StaticResource SettingDescription}"
                                           Text="英語などの発言を、文脈による補正と同じ AI (PC 内) が、直前の発言の流れと登録した用語を見て訳します。製品名などの取り違えが減りますが、翻訳モデルより時間がかかります (GPU があると速い)。AI が使えないときは翻訳モデルで訳します。"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <CheckBox x:Name="MinutesVoicesCheck" DockPanel.Dock="Right" Style="{StaticResource RowCheck}"
                                      Click="MinutesVoices_Click"/>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingLabel}" Text="名前を付けた話者の声を覚える"/>
                                <TextBlock Style="{StaticResource SettingDescription}"
                                           Text="話者に名前を付けると声の特徴を覚え、次の会議から似た声の話者に自動で名前を付けます。覚えるのは声の特徴 (数値) だけで、音声は保存しません。覚えた声は議事録の画面の「覚えた声」で確認・削除できます。"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ───────── ショートカット ───────── -->
        <TabItem Header="ショートカット">
            <ScrollViewer Style="{StaticResource Page}">
                <StackPanel x:Name="ShortcutList">
                    <TextBlock Style="{StaticResource SettingHeader}" Text="どのアプリを使っていても効くキー"/>
                    <TextBlock Style="{StaticResource SettingHeader}" Text="GetText のウィンドウで使うキー" x:Name="LocalShortcutHeader"/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ───────── 情報 ───────── -->
        <TabItem x:Name="InfoTab" Header="セットアップ・情報">
            <ScrollViewer Style="{StaticResource Page}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingHeader}" Text="セットアップと状態"/>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <Button x:Name="SetupButton" DockPanel.Dock="Right" Content="セットアップを実行" Margin="12,0,0,0" VerticalAlignment="Center"
                                    Style="{StaticResource AccentButtonStyle}" Click="Setup_Click"/>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingLabel}" Text="AI OCR・ローカル翻訳・議事録のセットアップ"/>
                                <TextBlock Style="{StaticResource SettingDescription}"
                                           Text="入れる機能 (フル 約 9GB・標準 約 5GB・最小 約 1GB) を、この PC に合うおすすめ付きで選べます。必要なソフト (Python) が無ければ自動で入れます。取得済みの分は省きます。"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingLabel}" Text="AI OCR (RapidOCR + PP-OCRv6 small, Apache-2.0)"/>
                            <TextBlock x:Name="AiOcrStatus" Style="{StaticResource SettingDescription}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingLabel}" Text="ローカル翻訳 (CTranslate2)"/>
                            <TextBlock Style="{StaticResource SettingDescription}"
                                       Text="英語: FuguMT (CC BY-SA 4.0) ・ その他の言語: NLLB-200 1.3B (CC BY-NC 4.0・非商用)"/>
                            <TextBlock x:Name="LocalTranslationStatus" Style="{StaticResource SettingDescription}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingLabel}" Text="議事録 (音声の文字起こし)"/>
                            <TextBlock Style="{StaticResource SettingDescription}"
                                       Text="音声認識: ReazonSpeech k2 v2 (日本語・軽さ優先, Apache-2.0)・kotoba-whisper v2.0 (日本語・正確さ優先, MIT)・Whisper large-v3 turbo (英語など, MIT) ・ 話者の聞き分け: 3D-Speaker CAM++ (Apache-2.0) ・ 無音検出: Silero VAD (MIT) ・ 文脈補正: Qwen3-4B-Instruct-2507 (Apache-2.0)"/>
                            <TextBlock x:Name="MinutesStatus" Style="{StaticResource SettingDescription}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SettingHeader}" Text="フォルダ"/>
                    <Border Style="{StaticResource SettingRow}">
                        <WrapPanel>
                            <Button Content="設定フォルダを開く" Margin="0,0,8,0" Click="OpenSettingsFolder_Click"/>
                            <Button Content="ログフォルダを開く" Margin="0,0,8,0" Click="OpenLogFolder_Click"/>
                            <Button Content="モデルのフォルダを開く" Click="OpenModelFolder_Click"/>
                        </WrapPanel>
                    </Border>
                    <TextBlock x:Name="VersionText" Style="{StaticResource SettingDescription}" Margin="2,12,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
