<Window x:Class="GetText.CommandPalette"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GetText"
        Title="GetText — コマンド" Width="580" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource Gt.Font.Body}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisible"/>
        <Style x:Key="ResultItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
            <EventSetter Event="MouseLeftButtonUp" Handler="Item_MouseUp"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="{StaticResource Gt.Radius.Button}" Padding="12,8"/>
                            <!-- 選んでいる行は背景に加えて左の印でも示す (色だけに頼らない) -->
                            <Border x:Name="Mark" Width="3" CornerRadius="2" Margin="0,10" HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Hidden"/>
                            <ContentPresenter Margin="12,8"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Gt.SubtleHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Gt.SubtleHover}"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 一時的に出す面 (影は 1 つだけ) -->
    <Border Margin="16" Background="{DynamicResource Gt.Surface}" BorderBrush="{DynamicResource Gt.Border}" BorderThickness="1"
            CornerRadius="{StaticResource Gt.Radius.Dialog}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.22" Direction="270"/>
        </Border.Effect>
        <DockPanel>
            <!-- 検索の欄 -->
            <Grid DockPanel.Dock="Top" Margin="16,12,12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Icon}" Text="{local:Icon Search}" Foreground="{DynamicResource Gt.TextSecondary}" Margin="0,0,12,0"/>
                <TextBox x:Name="QueryBox" Grid.Column="1" FontSize="{StaticResource Gt.Font.Body}" BorderThickness="0" Background="Transparent"
                         Foreground="{DynamicResource Gt.TextPrimary}" CaretBrush="{DynamicResource Gt.TextPrimary}"
                         VerticalContentAlignment="Center" Padding="0,4" TextChanged="QueryBox_TextChanged"
                         AutomationProperties.Name="コマンド・機能・設定を検索">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>
                <TextBlock x:Name="QueryPlaceholder" Grid.Column="1" Text="機能・操作・設定を検索 (例: 録画、検索、テーマ)" IsHitTestVisible="False"
                           Foreground="{DynamicResource Gt.TextTertiary}" VerticalAlignment="Center"/>
                <Border Grid.Column="2" Style="{StaticResource KeyCap}" Margin="8,0,0,0">
                    <TextBlock Text="Esc" FontSize="{StaticResource Gt.Font.Caption}" Foreground="{DynamicResource Gt.TextSecondary}"/>
                </Border>
            </Grid>
            <Rectangle DockPanel.Dock="Top" Height="1" Fill="{DynamicResource Gt.Divider}"/>

            <!-- 操作の説明 -->
            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Gt.Divider}" BorderThickness="0,1,0,0" Padding="16,8">
                <DockPanel>
                    <TextBlock x:Name="CountText" DockPanel.Dock="Right" Style="{StaticResource Caption}"/>
                    <TextBlock Style="{StaticResource Caption}" Text="↑↓ で選ぶ ・ Enter で実行 ・ Esc で閉じる"/>
                </DockPanel>
            </Border>

            <Grid>
                <ListBox x:Name="Results" MaxHeight="380" Margin="8,8,8,6" BorderThickness="0" Background="Transparent"
                         ItemContainerStyle="{StaticResource ResultItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" KeyboardNavigation.TabNavigation="None"
                         AutomationProperties.Name="コマンドの候補">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:PaletteItem}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{DynamicResource Gt.TextSecondary}"/>
                                    <Path Data="{Binding Geometry}" Stroke="{DynamicResource Gt.TextSecondary}" StrokeThickness="1.6" Width="16" Height="16"
                                          Stretch="Uniform" Visibility="{Binding HasGeometry, Converter={StaticResource BoolToVisible}}"/>
                                </Grid>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,8,0">
                                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Gt.TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}" Margin="12,0,0,0" FontSize="{StaticResource Gt.Font.Caption}"
                                               Foreground="{DynamicResource Gt.TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Style="{StaticResource KeyCap}" Margin="0,0,8,0"
                                            Visibility="{Binding HasShortcut, Converter={StaticResource BoolToVisible}}">
                                        <TextBlock Text="{Binding Shortcut}" FontSize="{StaticResource Gt.Font.Caption}" Foreground="{DynamicResource Gt.TextSecondary}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Category}" FontSize="{StaticResource Gt.Font.Caption}" Foreground="{DynamicResource Gt.TextTertiary}"
                                               MinWidth="48" TextAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <!-- 見つからないとき -->
                <StackPanel x:Name="EmptyState" Margin="24,28" Visibility="Collapsed" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}" Text="{local:Icon Search}" FontSize="24" HorizontalAlignment="Center"
                               Foreground="{DynamicResource Gt.TextTertiary}"/>
                    <TextBlock Text="見つかりませんでした" Margin="0,8,0,0" HorizontalAlignment="Center" FontWeight="SemiBold"
                               Foreground="{DynamicResource Gt.TextPrimary}"/>
                    <TextBlock Style="{StaticResource Caption}" Text="別の言葉 (英語の名前でも) で探してください" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
