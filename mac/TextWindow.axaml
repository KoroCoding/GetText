<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GetText.TextWindow"
        Title="GetText" Width="480" Height="600" MinWidth="360" MinHeight="260"
        Icon="avares://GetText/Assets/app.ico">
    <Window.Styles>
        <Style Selector="Border.chip">
            <Setter Property="Background" Value="{DynamicResource Subtle}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,1"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
    </Window.Styles>
    <Grid Margin="8,4,8,6" RowDefinitions="Auto,*,Auto">
        <!-- 操作バー (窓が狭いときはボタンを 2 段に折り返す。1 段のままだと右のボタンが切れて押せない) -->
        <Grid Grid.Row="0" Margin="0,0,0,6" ColumnDefinitions="*,Auto">
            <Button Grid.Column="1" Classes="command" Click="Settings_Click" ToolTip.Tip="設定 (⌘,)" VerticalAlignment="Top">
                <TextBlock Text="⚙ 設定"/>
            </Button>
            <WrapPanel Grid.Column="0" Orientation="Horizontal">
            <ToggleButton x:Name="PauseToggle" Classes="command" Click="PauseToggle_Click"
                          ToolTip.Tip="自動読み取りを一時停止 / 再開 (⌘P ・ どこからでも ⌃⌥P)">
                <TextBlock x:Name="PauseLabel" Text="❚❚ 一時停止"/>
            </ToggleButton>
            <Button Classes="command" Click="Refresh_Click" ToolTip.Tip="枠の中を今すぐ読み取る (⌘R ・ どこからでも ⌃⌥R)">
                <TextBlock Text="⟳ 今すぐ読取"/>
            </Button>
            <Rectangle Width="1" Height="16" Margin="6,0" VerticalAlignment="Center" Fill="{DynamicResource Divider}"/>
            <ToggleButton x:Name="AccumulateToggle" Classes="command" Click="AccumulateToggle_Click"
                          ToolTip.Tip="スクロールしながら読んだ内容を重複なしでつなげて集める (長い文書の取り込み用)">
                <TextBlock Text="⇣ 蓄積"/>
            </ToggleButton>
            <Rectangle Width="1" Height="16" Margin="6,0" VerticalAlignment="Center" Fill="{DynamicResource Divider}"/>
            <Button Classes="command" Click="Minutes_Click" ToolTip.Tip="アプリの音声を文字起こしして、時刻と話者つきの議事録を作る">
                <TextBlock Text="🎙 議事録"/>
            </Button>
            <Button x:Name="ClearButton" Classes="command" Click="Clear_Click" ToolTip.Tip="蓄積した内容を消して集め直す" IsVisible="False">
                <TextBlock Text="クリア"/>
            </Button>
            </WrapPanel>
        </Grid>

        <!-- 原文と日本語訳 (配置は設定で下 / 右を切り替える) -->
        <Grid x:Name="PaneGrid" Grid.Row="1" RowDefinitions="*,0,0" ColumnDefinitions="*,0,0">
            <Border x:Name="OcrCard" Classes="card">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="12,6,4,0">
                        <Button DockPanel.Dock="Right" Classes="icon" Content="💾" FontSize="12" Click="SaveOcr_Click" ToolTip.Tip="ファイルに保存"/>
                        <Button DockPanel.Dock="Right" Classes="icon" Content="⧉" Click="CopyOcr_Click"
                                ToolTip.Tip="コピー: 選択範囲があればその部分、なければ全文 (⌘⇧C ・ どこからでも ⌃⌥C)"/>
                        <TextBlock Classes="title" Text="原文"/>
                        <TextBlock x:Name="OcrNote" Classes="caption" Margin="10,0,6,0"/>
                    </DockPanel>
                    <Grid>
                        <TextBox x:Name="ResultBox" Classes="result"/>
                        <TextBlock x:Name="OcrPlaceholder" Classes="caption" Margin="14,6,14,0"
                                   VerticalAlignment="Top" TextWrapping="Wrap" TextTrimming="None" IsHitTestVisible="False"
                                   Text="青い枠を読み取りたい文字の上に重ねてください。枠の中の文字がここに表示されます。&#x0a;枠は上のバーで移動、右下の角でサイズ変更できます。"/>
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="Splitter" Background="Transparent" IsVisible="False" ToolTip.Tip="ドラッグで大きさを調整"/>

            <Border x:Name="TranslationCard" Classes="card" IsVisible="False">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="12,6,4,0">
                        <Button DockPanel.Dock="Right" Classes="icon" Content="💾" FontSize="12" Click="SaveTranslation_Click" ToolTip.Tip="ファイルに保存"/>
                        <Button DockPanel.Dock="Right" Classes="icon" Content="⧉" Click="CopyTranslation_Click"
                                ToolTip.Tip="コピー: 選択範囲があればその部分、なければ全文 (⌘⇧T ・ どこからでも ⌃⌥T)"/>
                        <TextBlock Classes="title" Text="日本語訳"/>
                        <TextBlock x:Name="TranslationNote" Classes="caption" Margin="10,0,6,0"/>
                    </DockPanel>
                    <Grid>
                        <TextBox x:Name="TranslationBox" Classes="result"/>
                        <TextBlock x:Name="TranslationPlaceholder" Classes="caption" Margin="14,6,14,0"
                                   VerticalAlignment="Top" TextWrapping="Wrap" TextTrimming="None" IsHitTestVisible="False"
                                   Text="英語・中国語・韓国語などの文があると、ここに日本語訳が表示されます。"/>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ステータスバー -->
        <DockPanel Grid.Row="2" Margin="4,6,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Border Classes="chip" ToolTip.Tip="文字の読み取り方式">
                    <TextBlock x:Name="OcrChip" Classes="caption"/>
                </Border>
                <Border x:Name="TranslationChipBorder" Classes="chip" ToolTip.Tip="翻訳エンジン">
                    <TextBlock x:Name="TranslationChip" Classes="caption"/>
                </Border>
            </StackPanel>
            <TextBlock x:Name="StatusText" Classes="caption"/>
        </DockPanel>
    </Grid>
</Window>
