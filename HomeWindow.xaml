<Window x:Class="GetText.HomeWindow"
        Icon="/Assets/app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GetText" Width="480" SizeToContent="Height" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <Window.Resources>
        <!-- 機能のカード (アイコン・名前・説明・状態・ボタン) -->
        <Style x:Key="FeatureCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FeatureIcon" TargetType="Border">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
        </Style>
        <Style x:Key="OpenChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="8,1"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#2216A34A"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="14,12,14,12">
        <DockPanel Margin="2,0,2,12">
            <Image Source="/Assets/app.ico" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="GetText" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Style="{StaticResource Caption}" Text="使う機能を選んでください (いくつでも同時に開けます。ここで切り替えられます)"
                           TextWrapping="Wrap" TextTrimming="None"/>
            </StackPanel>
        </DockPanel>

        <!-- 文字の読み取り -->
        <Border Style="{StaticResource FeatureCard}">
            <DockPanel>
                <Border Style="{StaticResource FeatureIcon}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8D3;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                </Border>
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button x:Name="OcrOpen" Style="{StaticResource AccentButtonStyle}" MinWidth="96" Click="OcrOpen_Click" Content="開く"
                            AutomationProperties.Name="文字の読み取りを開く"/>
                    <Button x:Name="OcrClose" MinWidth="96" Margin="0,6,0,0" Click="OcrClose_Click" Content="閉じる" Visibility="Collapsed"
                            AutomationProperties.Name="文字の読み取りを閉じる"/>
                </StackPanel>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource CardTitle}" Text="文字の読み取りと翻訳"/>
                        <Border x:Name="OcrChip" Style="{StaticResource OpenChip}">
                            <TextBlock Text="開いています" FontSize="11" Foreground="#15803D"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,3,0,0"
                               Text="画面に置いた枠の中の文字を読み取り、日本語に訳します。"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 議事録 -->
        <Border Style="{StaticResource FeatureCard}">
            <DockPanel>
                <Border Style="{StaticResource FeatureIcon}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE720;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                </Border>
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button x:Name="MinutesOpen" Style="{StaticResource AccentButtonStyle}" MinWidth="96" Click="MinutesOpen_Click" Content="開く"
                            AutomationProperties.Name="議事録を開く"/>
                    <Button x:Name="MinutesClose" MinWidth="96" Margin="0,6,0,0" Click="MinutesClose_Click" Content="閉じる" Visibility="Collapsed"
                            AutomationProperties.Name="議事録を閉じる"/>
                </StackPanel>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource CardTitle}" Text="議事録"/>
                        <Border x:Name="MinutesChip" Style="{StaticResource OpenChip}">
                            <TextBlock x:Name="MinutesChipText" Text="開いています" FontSize="11" Foreground="#15803D"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,3,0,0"
                               Text="会議アプリの音声を文字起こしして、話者と時刻つきの議事録を作ります。"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 画面の録画 -->
        <Border Style="{StaticResource FeatureCard}">
            <DockPanel>
                <Border Style="{StaticResource FeatureIcon}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE714;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                </Border>
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button x:Name="RecordOpen" Style="{StaticResource AccentButtonStyle}" MinWidth="96" Click="RecordOpen_Click" Content="開く"
                            AutomationProperties.Name="画面の録画を開く"/>
                    <Button x:Name="RecordClose" MinWidth="96" Margin="0,6,0,0" Click="RecordClose_Click" Content="閉じる" Visibility="Collapsed"
                            AutomationProperties.Name="画面の録画を閉じる"/>
                </StackPanel>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource CardTitle}" Text="画面の録画"/>
                        <Border x:Name="RecordChip" Style="{StaticResource OpenChip}">
                            <TextBlock x:Name="RecordChipText" Text="開いています" FontSize="11" Foreground="#15803D"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,3,0,0"
                               Text="選んだウィンドウ (または画面全体) を、その音も入れて MP4 に録画します。"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <DockPanel Margin="2,4,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource CommandPush}" Click="Exit_Click" ToolTip="GetText を終了します"
                    AutomationProperties.Name="GetText を終了">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7E8;" FontSize="13"/>
                    <TextBlock Text="終了" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource CommandPush}" Click="Settings_Click" ToolTip="設定 (読み取り・翻訳・表示・議事録・ショートカット・セットアップ)"
                    AutomationProperties.Name="設定">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="13"/>
                    <TextBlock Text="設定" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <CheckBox x:Name="MinimizeCheck" Content="開いたらこの画面を最小化する" VerticalAlignment="Center" Click="MinimizeCheck_Click"
                      ToolTip="機能を開くと、この画面はタスクバーにしまいます (機能をすべて閉じると戻ります)"/>
        </DockPanel>
    </StackPanel>
</Window>
