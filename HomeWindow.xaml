<Window x:Class="GetText.HomeWindow"
        Icon="/Assets/app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GetText"
        Title="GetText" Width="600" MinWidth="420" SizeToContent="Height" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource Gt.Font.Body}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisible"/>
    </Window.Resources>
    <StackPanel Margin="24,16,24,16">
        <!-- 見出し: GetText の印と名前 / 設定 -->
        <DockPanel Margin="0,0,0,16">
            <Button x:Name="SettingsButton" DockPanel.Dock="Right" Style="{StaticResource CommandPush}" Click="Settings_Click" VerticalAlignment="Center"
                    ToolTip="設定 (Ctrl+,)" AutomationProperties.Name="設定">
                <TextBlock Style="{StaticResource Icon}" Text="{local:Icon Settings}"/>
            </Button>
            <Viewbox Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center">
                <Canvas Width="24" Height="24">
                    <Path Data="{StaticResource BrandCorners}" Stroke="{DynamicResource AccentFillColorDefaultBrush}" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    <Path Data="{StaticResource BrandLines}" Stroke="{DynamicResource Gt.TextPrimary}" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Canvas>
            </Viewbox>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="GetText" FontFamily="{StaticResource Gt.Font.Display}" FontSize="{StaticResource Gt.Font.Subtitle}" FontWeight="SemiBold"
                           Foreground="{DynamicResource Gt.TextPrimary}"/>
                <TextBlock Style="{StaticResource Caption}" Text="画面の文字・会議・録画を、この PC の中で"/>
            </StackPanel>
        </DockPanel>

        <!-- 検索 (コマンドの一覧を開く) -->
        <Button x:Name="SearchButton" Click="Search_Click" Cursor="IBeam" Margin="0,0,0,24" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                ToolTip="機能・操作・設定・最近の議事録を探して実行します (Ctrl+K)" AutomationProperties.Name="機能・操作・設定を検索 (Ctrl+K)"
                FocusVisualStyle="{StaticResource RoundFocusVisual}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{DynamicResource Gt.Surface}" BorderBrush="{DynamicResource Gt.Border}" BorderThickness="1"
                            CornerRadius="{StaticResource Gt.Radius.Input}" Padding="12,8">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Gt.BorderStrong}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <DockPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource KeyCap}">
                    <TextBlock Text="Ctrl+K" FontSize="{StaticResource Gt.Font.Caption}" Foreground="{DynamicResource Gt.TextSecondary}"/>
                </Border>
                <TextBlock Style="{StaticResource Icon}" Text="{local:Icon Search}" Foreground="{DynamicResource Gt.TextSecondary}" Margin="0,0,12,0"/>
                <TextBlock Text="機能・操作・設定を検索" Foreground="{DynamicResource Gt.TextTertiary}" VerticalAlignment="Center"/>
            </DockPanel>
        </Button>

        <!-- 機能 (タイル全体を押して開く。開いているものは状態と閉じるボタンを出す) -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="機能"/>
        <ItemsControl x:Name="FeatureList" Focusable="False" KeyboardNavigation.TabNavigation="Continue">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid x:Name="TileGrid" Columns="3"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:FeatureTile}">
                    <Grid Margin="0,0,8,8">
                        <Button Style="{StaticResource TileButton}" Click="Tile_Click" MinHeight="148"
                                AutomationProperties.Name="{Binding AccessibleName}" ToolTip="{Binding ToolTip}">
                            <DockPanel>
                                <!-- 状態: 点 + 文字 (色だけに頼らない) -->
                                <Border DockPanel.Dock="Bottom" Style="{StaticResource StatusPill}" Margin="0,12,0,0" Background="{Binding PillBackground}"
                                        Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisible}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding StatusGlyph}" FontSize="12" Foreground="{Binding StatusForeground}"
                                                   Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding StatusLabel}" FontSize="{StaticResource Gt.Font.Caption}" Foreground="{Binding StatusForeground}"/>
                                    </StackPanel>
                                </Border>
                                <Border DockPanel.Dock="Top" Width="36" Height="36" CornerRadius="{StaticResource Gt.Radius.Card}" HorizontalAlignment="Left"
                                        Background="{DynamicResource Gt.AccentSubtle}" Margin="0,0,0,12">
                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="18" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource Gt.AccentText}"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource Gt.TextPrimary}"/>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               MaxHeight="50" Margin="0,4,0,0" VerticalAlignment="Top"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>
                        <!-- 開いているときだけ: 閉じる -->
                        <Button Style="{StaticResource IconButton}" Content="{local:Icon Close}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,6,6,0" Click="TileClose_Click" Visibility="{Binding CanClose, Converter={StaticResource BoolToVisible}}"
                                ToolTip="{Binding CloseLabel}" AutomationProperties.Name="{Binding CloseLabel}"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 最近の議事録 -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="最近の議事録" Margin="4,16,0,8"/>
        <Border Style="{StaticResource Card}" Padding="4">
            <Grid>
                <ItemsControl x:Name="RecentList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource RowButton}" Click="Recent_Click" Tag="{Binding Path}" ToolTip="{Binding Path}"
                                    AutomationProperties.Name="{Binding Label}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="{local:Icon ChevronRight}" FontSize="12"
                                               Foreground="{DynamicResource Gt.TextTertiary}"/>
                                    <TextBlock Style="{StaticResource Icon}" Text="{local:Icon Document}" Foreground="{DynamicResource Gt.TextSecondary}" Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- 空の状態: 何ができるかと、次にすること -->
                <DockPanel x:Name="RecentEmpty" Margin="12,12,12,12" Visibility="Collapsed">
                    <Button DockPanel.Dock="Right" Content="議事録を開く" VerticalAlignment="Center" Margin="12,0,0,0" Click="RecentEmptyOpen_Click"/>
                    <TextBlock Style="{StaticResource Icon}" Text="{local:Icon History}" FontSize="20" Foreground="{DynamicResource Gt.TextTertiary}"
                               Margin="0,0,12,0" VerticalAlignment="Top"/>
                    <StackPanel>
                        <TextBlock Text="まだ議事録はありません" FontWeight="SemiBold" Foreground="{DynamicResource Gt.TextPrimary}"/>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0"
                                   Text="会議を記録すると自動で保存され、ここからすぐに開けます。"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>

        <!-- 下: 動きの設定と終了 -->
        <DockPanel Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource CommandPush}" Click="Exit_Click" ToolTip="GetText を終了します"
                    AutomationProperties.Name="GetText を終了">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="{local:Icon Exit}" FontSize="14"/>
                    <TextBlock Text="終了" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <CheckBox x:Name="MinimizeCheck" Content="機能を開いたらホームを最小化" VerticalAlignment="Center" Click="MinimizeCheck_Click"
                      ToolTip="機能を開くと、この画面はタスクバーにしまいます (機能をすべて閉じると戻ります)"/>
        </DockPanel>
    </StackPanel>
</Window>
