<Window x:Class="GetText.KeyDialog"
        Icon="/Assets/app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeepL API キー" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <StackPanel Margin="16">
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
            DeepL の API キーを入力してください。無料プランのキーは末尾が「:fx」です。
            キーはこの PC の Windows ユーザーだけが復号できる形で暗号化して保存されます。
        </TextBlock>
        <PasswordBox x:Name="KeyBox" Margin="0,10,0,0" Padding="4" AutomationProperties.Name="DeepL API キー"/>
        <TextBlock Margin="0,8,0,0">
            <Hyperlink NavigateUri="https://www.deepl.com/pro-api" RequestNavigate="Link_RequestNavigate">DeepL API Free に登録してキーを取得する</Hyperlink>
        </TextBlock>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="キーを削除" Padding="12,3" Margin="0,0,8,0" Click="Clear_Click"/>
            <Button Content="保存" Padding="18,3" Margin="0,0,8,0" IsDefault="True" Click="Save_Click"/>
            <Button Content="キャンセル" Padding="12,3" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
