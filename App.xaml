<Application x:Class="GetText.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GetText"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             ShutdownMode="OnMainWindowClose">
    <!--
      色・文字の大きさ・角の丸みはデザイントークン (DesignTokens.cs → Theme.cs) が起動時に入れる:
        色      {DynamicResource Gt.TextPrimary} など (ライト / ダークで入れ替わる)
        文字    {StaticResource Gt.Font.Body} など
        角      {StaticResource Gt.Radius.Card} など
      画面に色や字体を直接書かない。アイコンは {local:Icon Search} のように意味の名前で使う。
    -->
    <Application.Resources>
        <!-- 文字の大きさと角の丸み (DesignTokens.WindowsType・WindowsRadii と同じ値。DesignSystemTests が一致を確かめる) -->
        <sys:Double x:Key="Gt.Font.Caption">12</sys:Double>
        <sys:Double x:Key="Gt.Font.Body">14</sys:Double>
        <sys:Double x:Key="Gt.Font.BodyStrong">14</sys:Double>
        <sys:Double x:Key="Gt.Font.Subtitle">20</sys:Double>
        <sys:Double x:Key="Gt.Font.Title">28</sys:Double>
        <sys:Double x:Key="Gt.Font.LargeTitle">40</sys:Double>
        <sys:Double x:Key="Gt.Font.Dense">13</sys:Double>
        <CornerRadius x:Key="Gt.Radius.Small">2</CornerRadius>
        <CornerRadius x:Key="Gt.Radius.Button">4</CornerRadius>
        <CornerRadius x:Key="Gt.Radius.Input">4</CornerRadius>
        <CornerRadius x:Key="Gt.Radius.Card">8</CornerRadius>
        <CornerRadius x:Key="Gt.Radius.Dialog">8</CornerRadius>

        <!-- GetText の印: 画面を切り取る枠の角 (⌜ ⌝ ⌞ ⌟) と、中の文字の行。24×24 の線 (アイコン・枠・README で同じ形) -->
        <Geometry x:Key="BrandCorners">M3,8 V3 H8 M16,3 H21 V8 M21,16 V21 H16 M8,21 H3 V16</Geometry>
        <Geometry x:Key="BrandLines">M8,10 H16 M8,14 H13</Geometry>

        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <!-- (起動時に DesignTokens の字体に置き換わる。ここは画面の設計用) -->
        <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, Yu Gothic UI, Meiryo UI</FontFamily>

        <!-- キーボード (Tab) で選んだときの枠 (マウスで押したときは出ない) -->
        <Style x:Key="RoundFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="{DynamicResource Gt.FocusRing}" BorderThickness="2" CornerRadius="6" Margin="-2"
                                SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 操作バーのボタン: 背景なし・マウスを乗せると薄く色が付く (アイコン + 文字) -->
        <Style x:Key="CommandButton" TargetType="ButtonBase">
            <Setter Property="Foreground" Value="{DynamicResource Gt.TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource RoundFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Gt.Radius.Button}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Gt.SubtleHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Gt.SubtlePressed}"/>
                            </Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Gt.TextDisabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CommandToggle" TargetType="ToggleButton" BasedOn="{StaticResource CommandButton}"/>
        <Style x:Key="CommandPush" TargetType="Button" BasedOn="{StaticResource CommandButton}"/>
        <!-- 押すとメニューが開くボタン (その他・表示の切り替え) -->
        <Style x:Key="CommandMenu" TargetType="ToggleButton" BasedOn="{StaticResource CommandButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Gt.Radius.Button}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Gt.SubtleHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Gt.SubtleHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Gt.TextDisabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- カード右上などの小さなアイコンボタン -->
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource CommandButton}">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource Gt.TextSecondary}"/>
        </Style>

        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- カード (原文・訳・設定のまとまり): 塗りつぶし + 細い枠。影は付けない -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Gt.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Gt.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource Gt.Radius.Card}"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Gt.TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Gt.Font.Caption}"/>
            <Setter Property="Foreground" Value="{DynamicResource Gt.TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- 画面の中の見出し (ホームの「最近の議事録」など) -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Gt.Font.BodyStrong}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Gt.TextPrimary}"/>
            <Setter Property="Margin" Value="4,0,0,8"/>
        </Style>

        <!-- ステータスバーの小さなラベル -->
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Gt.SubtleHover}"/>
            <Setter Property="CornerRadius" Value="{StaticResource Gt.Radius.Button}"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>

        <!-- キーの表示 (Ctrl+K など) -->
        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Gt.SurfaceSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Gt.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource Gt.Radius.Small}"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 状態の表示 (開いています・記録中など): 点 + 文字 (色だけに頼らない) -->
        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="{DynamicResource Gt.SuccessSubtle}"/>
        </Style>

        <!-- その場で知らせる帯 (InfoBar): 情報・警告・エラー。色と一緒にアイコンと文字でも伝える -->
        <Style x:Key="InfoBar" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource Gt.Radius.Button}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8,4,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="{DynamicResource Gt.AccentSubtle}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Gt.Border}"/>
        </Style>

        <!-- 全体を押せる行 (ホームの最近の議事録・設定の検索結果など) -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Gt.TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource RoundFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Gt.Radius.Button}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Gt.SubtleHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Gt.SubtlePressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ホームの機能のタイル (全体を押して開く) -->
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Gt.TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource Gt.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Gt.Border}"/>
            <Setter Property="Padding" Value="16,16,12,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource RoundFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource Gt.Radius.Card}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Gt.SurfaceHover}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Gt.BorderStrong}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Gt.SurfacePressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 結果を表示する読み取り専用の欄 (枠線なし) -->
        <Style x:Key="ResultText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="True"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{DynamicResource Gt.TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Gt.TextPrimary}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <!-- Fluent の ScrollViewer は Padding を使わないので外側で余白を取る -->
                        <Border Padding="12,4,4,8" Background="Transparent">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 設定画面 -->
        <Style x:Key="SettingHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="{StaticResource Gt.Font.BodyStrong}"/>
            <Setter Property="Foreground" Value="{DynamicResource Gt.TextPrimary}"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
        </Style>
        <Style x:Key="SettingRow" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Gt.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Gt.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource Gt.Radius.Button}"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Gt.TextPrimary}"/>
            <Setter Property="FontSize" Value="{StaticResource Gt.Font.Body}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SettingDescription" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Gt.TextSecondary}"/>
            <Setter Property="FontSize" Value="{StaticResource Gt.Font.Caption}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </Application.Resources>
</Application>
