<Project Sdk="Microsoft.NET.Sdk">

  <!-- 見本の拡張機能 (docs/plugins/development.md)。機能のタイル・コマンド・設定・知らせを登録するだけ。 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GetText.Plugins.Sample</RootNamespace>
    <Version>1.0.0</Version>
    <!-- 拡張機能のフォルダに依存の DLL も置く (GetText.Plugin.Abstractions は GetText のものを使うので置かない) -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\sdk\GetText.Plugin.Abstractions\GetText.Plugin.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="README.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
